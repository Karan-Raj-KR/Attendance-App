# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL (Supabase pooler URI for production)
# Leave unset to use local SQLite (backend/attendance.db)
# DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ── FAISS Persistence ────────────────────────────────────────────────
# Path to store FAISS index files. Mount a Railway volume at /data.
# Leave unset to use local ./faiss_indexes directory.
# FAISS_INDEX_PATH=/data/faiss_indexes

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (frontend URL in production)
# Leave unset for permissive localhost defaults.
# CORS_ORIGINS=https://your-app.vercel.app

# ── Cloudflare R2 (S3-compatible image storage) ─────────────────────
# Leave ALL unset to fall back to local disk storage.
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY=your_access_key
# R2_SECRET_KEY=your_secret_key
# R2_BUCKET_NAME=attendance-faces
